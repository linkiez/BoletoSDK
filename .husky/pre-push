echo "\n🚀 Running pre-push hook...\n"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"

echo "📋 Step 1/4: Running ESLint...\n"
yarn lint
if [ $? -ne 0 ]; then
  echo "\n❌ Linting failed! Fix the errors above before pushing.\n"
  exit 1
fi
echo "✅ Linting passed!\n"

echo "🔨 Step 2/4: Building TypeScript...\n"
yarn build
if [ $? -ne 0 ]; then
  echo "\n❌ Build failed! Fix the errors above before pushing.\n"
  exit 1
fi
echo "✅ Build passed!\n"

echo "🧪 Step 3/4: Running tests...\n"
yarn test
if [ $? -ne 0 ]; then
  echo "\n❌ Tests failed! Fix the failing tests before pushing.\n"
  exit 1
fi
echo "✅ Tests passed!\n"

echo "🔍 Step 4/4: Running SonarQube analysis...\n"
if [ -n "$SONAR_TOKEN" ] || [ -n "$SONAR_HOST_URL" ]; then
  yarn sonar
  if [ $? -ne 0 ]; then
    echo "\n⚠️  SonarQube analysis failed, but allowing push to continue.\n"
  else
    echo "✅ SonarQube analysis completed!\n"
  fi
else
  echo "⏭️  Skipping SonarQube (SONAR_TOKEN or SONAR_HOST_URL not configured)\n"
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✨ All pre-push checks passed! Ready to push.\n"
