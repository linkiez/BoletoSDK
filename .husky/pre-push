echo "\n🚀 Running pre-push hook...\n"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"

echo "📋 Step 1/3: Running ESLint...\n"
yarn lint
if [ $? -ne 0 ]; then
  echo "\n❌ Linting failed! Fix the errors above before pushing.\n"
  exit 1
fi
echo "✅ Linting passed!\n"

echo "🔨 Step 2/3: Building TypeScript...\n"
yarn build
if [ $? -ne 0 ]; then
  echo "\n❌ Build failed! Fix the errors above before pushing.\n"
  exit 1
fi
echo "✅ Build passed!\n"

echo "🧪 Step 3/3: Running tests...\n"
yarn test
if [ $? -ne 0 ]; then
  echo "\n❌ Tests failed! Fix the failing tests before pushing.\n"
  exit 1
fi
echo "✅ Tests passed!\n"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✨ All pre-push checks passed! Ready to push.\n"
