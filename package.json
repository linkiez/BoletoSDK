{
  "name": "@linkiez/boleto-sdk",
  "version": "1.1.4",
  "description": "SDK for Brazilian banking boletos and CNAB files processing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "benchmark:pdf-batch": "ts-node scripts/benchmark-pdf-batch.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint-staged": "lint-staged",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "sonar": "sonar-scanner",
    "prepare": "husky",
    "prepublishOnly": "yarn build && yarn test && yarn lint",
    "semantic-release": "semantic-release"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "boleto",
    "cnab",
    "cnab240",
    "cnab400",
    "banking",
    "brazil",
    "payment"
  ],
  "author": "Linkiez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkiez/BoletoSDK.git"
  },
  "bugs": {
    "url": "https://github.com/linkiez/BoletoSDK/issues"
  },
  "homepage": "https://github.com/linkiez/BoletoSDK#readme",
  "dependencies": {
    "pdfkit": "^0.17.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@linkiez/boleto-sdk": "^1.0.0",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.4",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.2.4",
    "semantic-release": "^25",
    "sonarqube-scanner": "^4.3.6",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "resolutions": {
    "axios": "^1.15.2",
    "picomatch": "^4.0.4"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-report.xml"
  },
  "packageManager": "yarn@4.16.0"
}
